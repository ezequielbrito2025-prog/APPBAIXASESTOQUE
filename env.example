# Copie para .env e ajuste. Nunca envie o .env para o Git.

# Senha de acesso da API (mínimo 16 caracteres). Gere uma com:  openssl rand -hex 24
API_TOKEN=troque-por-um-token-longo-e-secreto

# Banco PostgreSQL (na hospedagem, use a URL que o provedor fornece)
DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque

PORT=3000

# E-mail do relatório. Sem SMTP_HOST, o e-mail é gravado na pasta OUT_DIR (modo de teste).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=estoque@suaempresa.com.br

# Fechamento diário
SCHEDULER_ENABLED=true
FECHAMENTO_MAX_TENTATIVAS=5
FECHAMENTO_INTERVALO_MIN=10
# O horário (padrão 18:00) e o fuso (padrão America/Fortaleza) ficam no banco: PUT /configuracao
